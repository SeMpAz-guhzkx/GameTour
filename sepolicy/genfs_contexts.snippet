# Game Tour - genfs labels (duchamp / MT6897). Check the paths on your device.
# SPDX-License-Identifier: Apache-2.0
genfscon sysfs /devices/platform/soc/13000000.mali/devfreq/13000000.mali/cur_freq u:object_r:sysfs_gametour_gpu:s0
genfscon proc /mtk_mali/gpu_utilization u:object_r:proc_gametour_gpu:s0